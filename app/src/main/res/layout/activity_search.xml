<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/back"
        app:title="@string/search"
        style="@style/ToolbarStyle"/>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/inputEditText"
            android:saveEnabled="false"
            style="@style/TextViewSearchStyle"
            android:layout_marginHorizontal="@dimen/padding_medium"
            android:layout_marginTop="@dimen/padding_small_8"
            android:textCursorDrawable="@drawable/blue_cursor"
            android:imeOptions="actionDone"
            android:singleLine="true"/>
        <ImageView
            android:id="@+id/clearIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="28dp"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_cancel_16"
            android:background="?attr/colorOnBackground"
            app:tint="?attr/editTextColor"/>
    </FrameLayout>
    <FrameLayout android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/padding_medium"/>
    <FrameLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="102dp">
        <TextView
            android:id="@+id/placeHolderTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/ys_display_medium"
            android:drawablePadding="@dimen/padding_medium"
            android:text="@string/problem_with_internet"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="19sp"
            android:textFontWeight="400"
            android:visibility="gone"
            app:drawableTopCompat="@drawable/ic_ph_no_internet_120"/>
        <Button
            android:id="@+id/placeHolderButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/update"
            android:backgroundTint="@color/black"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/button_radius"
            android:fontFamily="@font/ys_display_medium"
            android:paddingHorizontal="14dp"
            android:textFontWeight="500"
            android:visibility="gone"/>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>